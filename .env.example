# InterviewOS Environment Variables
# Copy this file to .env and fill in your actual API keys

# LiveKit (for real-time voice infrastructure)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Deepgram API (for STT - Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic API (for Claude AI interviewer)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cartesia API (for TTS - Text-to-Speech)
CARTESIA_API_KEY=your_cartesia_api_key_here

# OpenAI API (legacy - kept for backward compatibility)
OPENAI_API_KEY=your_openai_api_key_here

# Agent tuning (optional — defaults shown)
SILENCE_THRESHOLD_MS=600         # ms of silence before VAD triggers turn end
MIN_ENDPOINTING_DELAY=0.6        # seconds to wait after speech stops before STT fires
MAX_ENDPOINTING_DELAY=5.0        # max wait to handle long thinking pauses