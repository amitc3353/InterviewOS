# InterviewOS Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenAI API (for TTS - Text-to-Speech)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (for Claude AI interviewer)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Deepgram API (for STT - Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Daily.co (for video/audio infrastructure)
DAILY_API_KEY=your_daily_api_key_here
DAILY_DOMAIN=your_daily_domain_here
