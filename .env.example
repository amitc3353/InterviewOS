# InterviewOS Environment Variables
# Copy this file to .env and fill in your actual API keys

# LiveKit (for real-time voice infrastructure)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Deepgram API (for STT - Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic API (for Claude AI interviewer)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cartesia API (for TTS - Text-to-Speech)
CARTESIA_API_KEY=your_cartesia_api_key_here

# OpenAI API (legacy - kept for backward compatibility)
OPENAI_API_KEY=your_openai_api_key_here

# Agent tuning (optional — defaults shown)
SILENCE_THRESHOLD_MS=600         # ms of silence before VAD triggers turn end
MIN_ENDPOINTING_DELAY=0.6        # seconds to wait after speech stops before STT fires
MAX_ENDPOINTING_DELAY=5.0        # max wait to handle long thinking pauses

# Logging configuration
LOG_LEVEL=INFO                   # Log level: DEBUG/INFO/WARNING/ERROR/CRITICAL
LOG_FORMAT=console               # Log format: "console" (human-readable) or "json" (structured)

# Error tracking (optional — GlitchTip/Sentry DSN)
SENTRY_DSN=                      # Leave empty to disable, or add your Sentry/GlitchTip DSN
SENTRY_ENVIRONMENT=production    # Environment name (development, staging, production)
SENTRY_ENABLED=false             # Set to false to disable Sentry entirely

# Discord webhook for alerts (optional — for GlitchTip webhook proxy)
DISCORD_WEBHOOK_URL=             # Discord webhook URL from Channel Settings → Integrations → Webhooks
                                 # Format: https://discord.com/api/webhooks/{webhook.id}/{webhook.token}

# Webhook proxy configuration (optional)
WEBHOOK_PROXY_PORT=8080          # Port for webhook proxy server
WEBHOOK_PROXY_HOST=0.0.0.0       # Host to bind webhook proxy (0.0.0.0 for all interfaces)